# ZZieRa 루트 설정
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# 설정 파일 직접 접근 차단
<Files "config.php">
    Require all denied
</Files>

# 점(.)으로 시작하는 파일, 문서·DB·배치·로그 파일 차단
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|sqlite|sqlite-wal|sqlite-shm|db|bat|ps1|ini|log|lock|json|tmp)$">
    Require all denied
</FilesMatch>
